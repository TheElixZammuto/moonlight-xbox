Retry DecoderBeginFrame if it returns D3DERR_WASSTILLDRAWING.
See https://learn.microsoft.com/en-us/windows/win32/api/d3d11/nf-d3d11-id3d11videocontext-decoderbeginframe

diff --git a/libavcodec/dxva2.c b/libavcodec/dxva2.c
--- a/libavcodec/dxva2.c
+++ b/libavcodec/dxva2.c
@@ -33,6 +33,11 @@
 #include "decode.h"
 #include "dxva2_internal.h"

+/* D3D11VA-only builds may not include the D3D9 error definitions. */
+#ifndef D3DERR_WASSTILLDRAWING
+#define D3DERR_WASSTILLDRAWING ((HRESULT)0x8876021c)
+#endif
+
 /* define all the GUIDs used directly here,
  to avoid problems with inconsistent dxva2api.h versions in mingw-w64 and different MSVC version */
 DEFINE_GUID(ff_DXVA2_ModeMPEG2_VLD,      0xee27417f, 0x5e28,0x4e65,0xbe,0xea,0x1d,0x26,0xb5,0x08,0xad,0xc9);
@@ -929,7 +934,8 @@
                                                  get_surface(avctx, frame),
                                                  NULL);
 #endif
-        if (hr != E_PENDING || ++runs > 50)
+        /* Both results indicate that the decoder is temporarily busy. */
+        if ((hr != E_PENDING && hr != D3DERR_WASSTILLDRAWING) || ++runs > 50)
             break;
         ff_dxva2_unlock(avctx);
         av_usleep(2000);
