<ContentDialog
    x:Class="moonlight_xbox_dx.AppActionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="350"
    CornerRadius="12"
    BorderBrush="Transparent"
    BorderThickness="0">

    <ContentDialog.Background>
        <AcrylicBrush TintColor="#FFF"
                      TintOpacity="0.01"
                      TintLuminosityOpacity="0.05"
                      FallbackColor="Transparent" />
    </ContentDialog.Background>

    <ContentDialog.Resources>
        <Style x:Key="ButtonIconContainerStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Spacing" Value="16"/>
        </Style>

        <Style x:Key="HamburgerButtonIconContainerStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="12"/>
        </Style>

        <Style x:Key="ButtonIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ButtonLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Background="Transparent" Padding="0">
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="0">
            <Border CornerRadius="12" Margin="0,0,0,16">
                <Border.Background>
                    <AcrylicBrush TintOpacity="0.75" TintLuminosityOpacity="0.35" TintColor="{ThemeResource SystemAccentColor}"/>
                </Border.Background>
                <TextBlock x:Name="AppNameHeader"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="Bahnschrift"
                           FontSize="20"
                           Foreground="White"
                           Padding="32,12,32,10"
                           MaxWidth="280"
                           TextWrapping="WrapWholeWords" />
            </Border>

            <Grid ColumnSpacing="16" RowSpacing="8" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Button x:Name="ResumeButton" Margin="0,0,0,8" Style="{StaticResource HamburgerButtonStyle}">
                        <StackPanel Style="{StaticResource HamburgerButtonIconContainerStyle}">
                            <FontIcon Style="{StaticResource ButtonIconStyle}" VerticalAlignment="Center" Glyph="&#xE768;"/>
                            <TextBlock Style="{StaticResource ButtonLabelStyle}" VerticalAlignment="Center" Text="Resume App"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CloseButton" Margin="0,0,0,8" Style="{StaticResource HamburgerButtonStyle}">
                        <StackPanel Style="{StaticResource HamburgerButtonIconContainerStyle}">
                            <FontIcon Style="{StaticResource ButtonIconStyle}" VerticalAlignment="Center" Glyph="&#xE711;"/>
                            <TextBlock Style="{StaticResource ButtonLabelStyle}" VerticalAlignment="Center" Text="Close App"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CloseAndStartButton" Margin="0,0,0,8" Style="{StaticResource HamburgerButtonStyle}">
                        <StackPanel Style="{StaticResource HamburgerButtonIconContainerStyle}">
                            <FontIcon Style="{StaticResource ButtonIconStyle}" VerticalAlignment="Center" Glyph="&#xE8AF;"/>
                            <TextBlock Style="{StaticResource ButtonLabelStyle}" VerticalAlignment="Center" Text="Close &amp; Start"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="StartButton" Margin="0,0,0,8" Style="{StaticResource HamburgerButtonStyle}">
                        <StackPanel Style="{StaticResource HamburgerButtonIconContainerStyle}">
                            <FontIcon Style="{StaticResource ButtonIconStyle}" VerticalAlignment="Center" Glyph="&#xE768;"/>
                            <TextBlock Style="{StaticResource ButtonLabelStyle}" VerticalAlignment="Center" Text="Start App"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="FavoriteButton" Margin="0,0,0,8" Style="{StaticResource HamburgerButtonStyle}">
                        <StackPanel Style="{StaticResource HamburgerButtonIconContainerStyle}">
                            <FontIcon x:Name="FavoriteIcon" Style="{StaticResource ButtonIconStyle}" VerticalAlignment="Center" Glyph="&#xE734;"/>
                            <TextBlock x:Name="FavoriteLabel" Style="{StaticResource ButtonLabelStyle}" VerticalAlignment="Center" Text="Add to Favorites"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button x:Name="HostSettingsButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource DialogButtonStyle}">
                    <StackPanel Style="{StaticResource ButtonIconContainerStyle}">
                        <FontIcon Style="{StaticResource ButtonIconStyle}" Glyph="&#xE713;"/>
                        <TextBlock Style="{StaticResource ButtonLabelStyle}" Text="Host Settings"/>
                    </StackPanel>
                </Button>

                <Button x:Name="MoonlightSettingsButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource DialogButtonStyle}">
                    <StackPanel Style="{StaticResource ButtonIconContainerStyle}">
                        <FontIcon Style="{StaticResource ButtonIconStyle}" Glyph="&#xE708;"/>
                        <TextBlock Style="{StaticResource ButtonLabelStyle}" Text="Moonlight Settings"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</ContentDialog>
