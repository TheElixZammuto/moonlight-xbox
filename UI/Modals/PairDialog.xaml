<ContentDialog
    x:Class="moonlight_xbox_dx.PairDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="350"
    CornerRadius="12"
    BorderBrush="Transparent"
    BorderThickness="0">

    <ContentDialog.Background>
        <AcrylicBrush TintColor="#FFF"
                      TintOpacity="0.01"
                      TintLuminosityOpacity="0.05"
                      FallbackColor="Transparent" />
    </ContentDialog.Background>

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="DialogButtonBackground" Color="#99000000"/>
        <SolidColorBrush x:Key="DialogButtonForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DialogButtonPointerOverBackground" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="DialogButtonPressedBackground" Color="{ThemeResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="DialogButtonFocusedBackground" Color="#EE000000"/>

        <Style x:Key="ButtonLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DialogButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource DialogButtonForeground}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Padding="0,2">
                            <Border x:Name="BackgroundLayer"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Background" Value="{StaticResource DialogButtonBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Background" Value="{StaticResource DialogButtonPointerOverBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Background" Value="{StaticResource DialogButtonPressedBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Opacity" Value="0.4"/>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Background" Value="{StaticResource DialogButtonFocusedBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HamburgerButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </ContentDialog.Resources>

    <Grid Background="Transparent" Padding="0">
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="0">

            <Border CornerRadius="12" Margin="0,0,0,12">
                <Border.Background>
                    <AcrylicBrush TintOpacity="0.75" TintLuminosityOpacity="0.25" TintColor="{ThemeResource SystemAccentColor}"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Padding="32,12,32,10">
                    <FontIcon FontFamily="Segoe MDL2 Assets"
                              Glyph="&#xE72E;"
                              FontSize="14"
                              VerticalAlignment="Center"
                              Foreground="White"/>
                    <TextBlock FontFamily="Bahnschrift"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Text="Pair Host"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Margin="0,0,0,12" Padding="24,24">
                
                <Border.Background>
                    <SolidColorBrush Color="#99000000"/>
                </Border.Background>
                
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    
                    <TextBlock FontFamily="Bahnschrift"
                               FontSize="10"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#CCFFFFFF"
                               Text="Enter this PIN on your host to complete pairing"
                               MaxWidth="240"/>

                    <Border CornerRadius="12" Padding="10">
                        
                        <Border.Background>
                            <AcrylicBrush TintColor="#010101" TintLuminosityOpacity="0" TintOpacity="1"/>
                        </Border.Background>
                        
                        <TextBlock x:Name="PinText"
                               FontFamily="Bahnschrift"
                               Margin="0,8,0,-10"
                               FontSize="56"
                               FontWeight="Bold"
                               CharacterSpacing="200"
                               TextAlignment="Center"
                               Foreground="White"/>
                    </Border>
                        
                </StackPanel>
                
            </Border>

            <Button x:Name="OkButton" Style="{StaticResource HamburgerButtonStyle}">
                <TextBlock Style="{StaticResource ButtonLabelStyle}" Text="Cancel" FontSize="12"/>
            </Button>

        </StackPanel>
    </Grid>
</ContentDialog>
