<ContentDialog
    x:Class="moonlight_xbox_dx.AddHostDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="350"
    CornerRadius="12"
    BorderBrush="Transparent"
    BorderThickness="0">

    <ContentDialog.Background>
        <AcrylicBrush TintColor="#FFF"
                      TintOpacity="0.01"
                      TintLuminosityOpacity="0.05"
                      FallbackColor="Transparent" />
    </ContentDialog.Background>

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="DialogButtonBackground" Color="#99000000"/>
        <SolidColorBrush x:Key="DialogButtonForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DialogButtonPointerOverBackground" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="DialogButtonPressedBackground" Color="{ThemeResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="DialogButtonFocusedBackground" Color="#EE000000"/>

        <Style x:Key="ButtonIconContainerStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Spacing" Value="12"/>
            <Setter Property="Orientation" Value="Horizontal"/>
        </Style>

        <Style x:Key="ButtonIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ButtonLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DialogButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource DialogButtonForeground}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Padding="0,2">
                            <Border x:Name="BackgroundLayer"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Background" Value="{StaticResource DialogButtonBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Background" Value="{StaticResource DialogButtonPointerOverBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Background" Value="{StaticResource DialogButtonPressedBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Opacity" Value="0.4"/>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Background" Value="{StaticResource DialogButtonFocusedBackground}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button: accent color in Normal state -->
        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="{StaticResource DialogButtonForeground}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="125"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Padding="0,2">
                            <Border x:Name="BackgroundLayer"
                                    Background="{ThemeResource SystemAccentColor}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Opacity" Value="0.85"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Opacity" Value="0.65"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Opacity" Value="0.4"/>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="BackgroundLayer.Opacity" Value="0.75"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentDialog.Resources>

    <Grid Background="Transparent" Padding="0">
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="0">

            <Border CornerRadius="12" Margin="0,0,0,12">
                <Border.Background>
                    <AcrylicBrush TintOpacity="0.75" TintLuminosityOpacity="0.25" TintColor="{ThemeResource SystemAccentColor}"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Padding="32,12,32,10">
                    <FontIcon FontFamily="Segoe MDL2 Assets"
                              Glyph="&#xE8FA;"
                              FontSize="14"
                              VerticalAlignment="Center"
                              Foreground="White"/>
                    <TextBlock Text="Add Host"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="Bahnschrift"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="12" Margin="0,0,0,12" Padding="20,16">
                <Border.Background>
                    <SolidColorBrush Color="#99000000"/>
                </Border.Background>
                <StackPanel Spacing="0">
                    <TextBlock Text="Hostname or IP address"
                               FontFamily="Bahnschrift"
                               FontSize="10"
                               Foreground="#99FFFFFF"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="HostnameTextBox"
                             AcceptsReturn="False"
                             PlaceholderText="e.g. 192.168.1.100"
                             FontFamily="Bahnschrift"
                             FontSize="14"
                             CornerRadius="8"/>
                    <TextBlock x:Name="ErrorText"
                               FontFamily="Bahnschrift"
                               FontSize="11"
                               Foreground="#EFF44336"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="RecentHostsBorder" CornerRadius="12" Margin="0,0,0,12" Padding="16,12" Visibility="Collapsed">
                <Border.Background>
                    <SolidColorBrush Color="#99000000"/>
                </Border.Background>
                <StackPanel Spacing="4">
                    <TextBlock Text="Recent"
                               FontFamily="Bahnschrift"
                               FontSize="10"
                               Foreground="#99FFFFFF"
                               Margin="0,0,0,4"/>
                    <StackPanel x:Name="RecentHostsPanel" Spacing="4"/>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AddButton" Grid.Column="0" Style="{StaticResource DialogButtonStyle}">
                    <StackPanel Style="{StaticResource ButtonIconContainerStyle}">
                        <FontIcon Style="{StaticResource ButtonIconStyle}" Glyph="&#xE710;"/>
                        <TextBlock Style="{StaticResource ButtonLabelStyle}" Text="Add"/>
                    </StackPanel>
                </Button>

                <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource DialogButtonStyle}">
                    <StackPanel Style="{StaticResource ButtonIconContainerStyle}">
                        <FontIcon Style="{StaticResource ButtonIconStyle}" Glyph="&#xE711;"/>
                        <TextBlock Style="{StaticResource ButtonLabelStyle}" Text="Cancel"/>
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </Grid>
</ContentDialog>
