<UserControl
    x:Class="moonlight_xbox_dx.LunarPhaseControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="160" Height="160">

    <Grid Width="160" Height="160" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ScaleXform" ScaleX="0.6" ScaleY="0.6"/>
        </Grid.RenderTransform>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Normal">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ScaleXform"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="0.5" Duration="0:0:0.125" EnableDependentAnimation="True"/>
                        <DoubleAnimation Storyboard.TargetName="ScaleXform"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="0.5" Duration="0:0:0.125" EnableDependentAnimation="True"/>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Selected">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="ScaleXform"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="0.85" Duration="0:0:0.125" EnableDependentAnimation="True"/>
                        <DoubleAnimation Storyboard.TargetName="ScaleXform"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="0.85" Duration="0:0:0.125" EnableDependentAnimation="True"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="DashedStates">
                <VisualState x:Name="Solid">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="SolidLayer"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="DashedLayer"
                                         Storyboard.TargetProperty="Opacity"
                                         To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Dashed">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="SolidLayer"
                                         Storyboard.TargetProperty="Opacity"
                                         To="0" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="DashedLayer"
                                         Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Solid layer: crescent fill + ring outline -->
        <Grid x:Name="SolidLayer">
            <!-- Crescent path: PathGeometry is assigned entirely in code-behind -->
            <Path x:Name="CrescentPath" Fill="White"/>
            <!-- White stroke ring -->
            <Ellipse x:Name="RingEllipse"
                     Width="152" Height="152"
                     Stroke="#bbFFFFFF" StrokeThickness="1"
                     Fill="Transparent"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Dashed layer: same geometry, dashed strokes, no fill; fades in when unavailable -->
        <Grid x:Name="DashedLayer" Opacity="0">
            <Path x:Name="DashedCrescentPath"
                  Fill="Transparent"
                  Stroke="#bbFFFFFF" StrokeThickness="1.2"
                  StrokeDashArray="4,4"/>
            <Ellipse x:Name="DashedRingEllipse"
                     Width="152" Height="152"
                     Stroke="#bbFFFFFF" StrokeThickness="1"
                     Fill="Transparent"
                     StrokeDashArray="5,4"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Lock overlay icon -->
        <Image x:Name="LockIcon"
               Source="ms-appx:///Assets/lock.svg"
               Width="32" Height="32"
               Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Disconnected overlay icon -->
        <Image x:Name="DisconnectedIcon"
               Source="ms-appx:///Assets/disconnected1.svg"
               Width="32" Height="32"
               Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Orbit load GIF: shown during WoLPolling.
             To nudge alignment, change X and Y on OrbitGifOffset below. -->
        <Image x:Name="OrbitGif"
               Source="ms-appx:///Assets/orbit_load3.gif"
               Width="160" Height="160"
               Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="OrbitGifOffset" X="0" Y="-1"/>
                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- Orbit pivot at ring center; dot position driven entirely by keyframe animations -->
        <Canvas x:Name="OrbitCanvas"
                Width="0" Height="0"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="80,80,0,0"
                Visibility="Collapsed">
            <Ellipse x:Name="OrbitDot" Width="10" Height="10" Fill="White"
                     Canvas.Left="-5" Canvas.Top="23"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="OrbitDotScale"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
    </Grid>
</UserControl>
