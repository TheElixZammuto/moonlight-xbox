<UserControl
    x:Class="moonlight_xbox_dx.SwatchPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="root">

    <GridView x:Name="SwatchGrid"
              IsItemClickEnabled="True"
              ItemClick="SwatchGrid_ItemClick"
              SelectionMode="None"
              HorizontalAlignment="Left">
        <GridView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" />
            </ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
            <DataTemplate>
                <Grid Width="36" Height="36">
                    <!-- Color fill -->
                    <Rectangle RadiusX="6" RadiusY="6" Margin="2">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="{Binding DisplayColor}" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Selected: white outline ring -->
                    <Rectangle RadiusX="10" RadiusY="10"
                               Stroke="White" StrokeThickness="1.5"
                               Visibility="{Binding CheckVisibility, Mode=OneWay}"
                               Fill="Transparent"
                               Margin="0" />
                    <!-- Selected: checkmark -->
                    <TextBlock Text="&#xE73E;"
                               FontFamily="Segoe Fluent Icons"
                               Visibility="{Binding CheckVisibility, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White" />
                    <!-- System accent star badge (bottom-right) -->
                    <TextBlock Text="&#xE734;"
                               FontFamily="Segoe Fluent Icons"
                               Visibility="{Binding SystemIndicatorVisibility}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Foreground="White"
                               FontSize="10"
                               Margin="0,0,5,5" />
                    <!-- Custom color pencil badge (bottom-right) -->
                    <TextBlock Text="&#xE70F;"
                               FontFamily="Segoe Fluent Icons"
                               Visibility="{Binding CustomIndicatorVisibility}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Foreground="White"
                               FontSize="10"
                               Margin="0,0,5,5" />
                </Grid>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</UserControl>
