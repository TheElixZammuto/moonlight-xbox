<UserControl
    x:Class="moonlight_xbox_dx.SwipeRevealBackground"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="Black" SizeChanged="Grid_SizeChanged">

        <!-- Base gradient: always visible, fallback when images haven't loaded yet -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF060818" Offset="0.0"/>
                    <GradientStop Color="#FF0D1A3A" Offset="0.5"/>
                    <GradientStop Color="#FF060818" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Back image layer: fully visible current app, always panning -->
        <Rectangle x:Name="BackRect" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Rectangle.Fill>
                <ImageBrush x:Name="BackBrush" Stretch="UniformToFill">
                    <ImageBrush.RelativeTransform>
                        <!-- ScaleX/Y=1.1 gives 5% headroom per side for pan without showing gaps -->
                        <CompositeTransform x:Name="BackPan" ScaleX="1.1" ScaleY="1.1" CenterX="0.5" CenterY="0.5"/>
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Front image layer: N horizontal slices, each clipped by a RectangleGeometry.
             Staggered clip widths per row produce the diagonal edge.
             ImageBrush and CompositeTransform are created/shared in code. -->
        <Grid x:Name="FrontGrid" IsHitTestVisible="False"/>

        <!-- Acrylic glass edge strip: rides the leading edge of the wipe -->
        <Border x:Name="GlassEdge"
                Width="64"
                Opacity="0"
                IsHitTestVisible="False"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Left"
                BorderThickness="2,0,2,0">
            <Border.Background>
                <AcrylicBrush TintColor="#FFFFFF" TintOpacity="0.10" TintLuminosityOpacity="0.30"/>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#80FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#20FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#80FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <TransformGroup>
                    <!-- AngleX and CenterY set in code; CenterX is half the fixed width -->
                    <SkewTransform x:Name="GlassEdgeSkew" CenterX="32"/>
                    <TranslateTransform x:Name="GlassEdgeTranslate"/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>

        <!-- Dark overlay for UI readability -->
        <Rectangle Opacity="0.7" IsHitTestVisible="False">
            <Rectangle.Fill><SolidColorBrush Color="Black"/></Rectangle.Fill>
        </Rectangle>

        <!-- Vignette -->
        <Grid Opacity="0.35" IsHitTestVisible="False">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#CC000000" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="0.25"/>
                        <GradientStop Color="#00000000" Offset="0.75"/>
                        <GradientStop Color="#CC000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#CC000000" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="0.2"/>
                        <GradientStop Color="#00000000" Offset="0.8"/>
                        <GradientStop Color="#CC000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Grid>
</UserControl>
