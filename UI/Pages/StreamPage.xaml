<Page
    x:Class="moonlight_xbox_dx.StreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ThemeBackgroundColor}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <local:BoolToTextConverter x:Key="BoolToTextConverter" TrueText="On" FalseText="Off" />
        <Style x:Key="StreamActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="85" />
            <Setter Property="Height" Value="85" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="FocusVisualPrimaryThickness" Value="0" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFF" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="BackgroundBorder" CornerRadius="12" Background="Transparent">
                                <Grid>
                                    <!-- base subtle acrylic -->
                                    <Rectangle x:Name="BackgroundBase" RadiusX="12" RadiusY="12">
                                        <Rectangle.Fill>
                                            <AcrylicBrush BackgroundSource="Backdrop" TintColor="#000" TintOpacity="0.3" TintLuminosityOpacity="0.2" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <!-- accent acrylic overlay that becomes visible when enabled/active -->
                                    <Rectangle x:Name="BackgroundAccent" RadiusX="12" RadiusY="12" Opacity="0">
                                        <Rectangle.Fill>
                                            <AcrylicBrush BackgroundSource="Backdrop" TintColor="{ThemeResource SystemAccentColor}" TintOpacity="0.5" TintLuminosityOpacity="0.5" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <!-- white overlay shown when focused/selected -->
                                    <Rectangle x:Name="FocusLayer" RadiusX="12" RadiusY="12" Fill="White" Opacity="0" />
                                </Grid>
                            </Border>

                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <!-- white background when focused/selected -->
                                            <Setter Target="FocusLayer.Opacity" Value="0" />
                                            <Setter Target="BackgroundAccent.Opacity" Value="1" />
                                            <Setter Target="BackgroundBorder.BorderThickness" Value="0"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused">
                                        <VisualState.Setters>
                                            <Setter Target="FocusLayer.Opacity" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Name="MenuShowStoryboard">
            <DoubleAnimation Storyboard.TargetName="FirstMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FirstMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="KeyboardMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0.04">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="KeyboardMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.04"/>
            <DoubleAnimation Storyboard.TargetName="StatsMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0.08">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatsMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="LogsMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogsMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="otherActionsButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0.16">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="otherActionsButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetName="DisconnectMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DisconnectMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CloseAppMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0.24">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CloseAppMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.24"/>
            <DoubleAnimation Storyboard.TargetName="MenuDimOverlay" Storyboard.TargetProperty="Opacity" From="0" To="0.5" Duration="0:0:0.2" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="MenuHideStoryboard" Completed="MenuHideStoryboard_Completed">
            <DoubleAnimation Storyboard.TargetName="FirstMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FirstMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="KeyboardMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0.04">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="KeyboardMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0.04"/>
            <DoubleAnimation Storyboard.TargetName="StatsMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0.08">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatsMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="LogsMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogsMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="otherActionsButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0.16">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="otherActionsButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetName="DisconnectMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DisconnectMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="CloseAppMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0.24">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CloseAppMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0.24"/>
            <DoubleAnimation Storyboard.TargetName="MenuDimOverlay" Storyboard.TargetProperty="Opacity" From="0.5" To="0" Duration="0:0:0.15" BeginTime="0:0:0.26">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Sub-menu: animate bottom-up (Pacing first, Guides last) on show -->
        <Storyboard x:Name="SubMenuShowStoryboard">
            <DoubleAnimation Storyboard.TargetName="FramePacingMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FramePacingMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="ResetDecoderMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0.04">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ResetDecoderMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.04"/>
            <DoubleAnimation Storyboard.TargetName="ToggleHDRMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0.08">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ToggleHDRMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="GuideShortMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GuideShortMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="GuideLongMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="80" To="0" Duration="0:0:0.26" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GuideLongMenuButton" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.12"/>
        </Storyboard>

        <!-- Sub-menu: animate top-down (Guides first, Pacing last) on hide -->
        <Storyboard x:Name="SubMenuHideStoryboard" Completed="SubMenuHideStoryboard_Completed">
            <DoubleAnimation Storyboard.TargetName="GuideShortMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GuideShortMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="GuideLongMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GuideLongMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="ToggleHDRMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0.04">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ToggleHDRMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0.04"/>
            <DoubleAnimation Storyboard.TargetName="ResetDecoderMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0.08">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ResetDecoderMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0.08"/>
            <DoubleAnimation Storyboard.TargetName="FramePacingMenuButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="80" Duration="0:0:0.22" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FramePacingMenuButton" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16" BeginTime="0:0:0.12"/>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <SwapChainPanel x:Name="swapChainPanel" Margin="{x:Bind State.ScreenMargin}">
<StackPanel HorizontalAlignment="Stretch" x:Name="KeyboardView" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="64,0,64,16" Padding="8,8,8,8">
                <StackPanel.Background>
                    <SolidColorBrush Color="{ThemeResource SystemColorBackgroundColor}" Opacity="0.75" />
                </StackPanel.Background>
                <local:KeyboardControl OnKeyDown="Keyboard_OnKeyDown" OnKeyUp="Keyboard_OnKeyUp" x:Name="Keyboard"/>
            </StackPanel>

            <Rectangle x:Name="MenuDimOverlay" Fill="Black" Opacity="0" IsHitTestVisible="False" />

            <Grid x:Name="StreamMenuGrid" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="20,0,20,20" MaxWidth="980" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sub-menu panel: shown on focus of Other button, hidden by default -->
                <Grid x:Name="OtherSubMenuPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="8" Visibility="Collapsed" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Guide Short + Guide Long side by side (col 4 and 5) -->
                    <Button x:Name="GuideShortMenuButton" Grid.Row="0" Grid.Column="4"
                            Style="{StaticResource StreamActionButtonStyle}" Click="guideButtonShort_Click" Opacity="0"
                            GotFocus="SubMenuButton_GotFocus" LostFocus="SubMenuButton_LostFocus" Margin="0,0,0,8">
                        <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xe80f;" FontSize="24" HorizontalAlignment="Center" />
                            <TextBlock Text="Guide Button (short)" TextAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="GuideLongMenuButton" Grid.Row="0" Grid.Column="5"
                            Style="{StaticResource StreamActionButtonStyle}" Click="guideButtonLong_Click" Opacity="0"
                            GotFocus="SubMenuButton_GotFocus" LostFocus="SubMenuButton_LostFocus" Margin="0,0,0,8">
                        <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xe80f;" FontSize="24" HorizontalAlignment="Center" />
                            <TextBlock Text="Guide Button (long)" TextAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <!-- Row 1: Toggle HDR -->
                    <Button x:Name="ToggleHDRMenuButton" Grid.Row="1" Grid.Column="4"
                            Style="{StaticResource StreamActionButtonStyle}" Click="toggleHDR_WinAltB_Click" Opacity="0"
                            GotFocus="SubMenuButton_GotFocus" LostFocus="SubMenuButton_LostFocus" Margin="0,0,0,8">
                        <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xe706;" FontSize="24" HorizontalAlignment="Center" />
                            <TextBlock Text="Toggle HDR (Win-Alt-B)" TextAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <!-- Row 2: Reset Decoder -->
                    <Button x:Name="ResetDecoderMenuButton" Grid.Row="2" Grid.Column="4"
                            Style="{StaticResource StreamActionButtonStyle}" Click="resetDecoder_Click" Opacity="0"
                            GotFocus="SubMenuButton_GotFocus" LostFocus="SubMenuButton_LostFocus" Margin="0,0,0,8">
                        <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="24" HorizontalAlignment="Center" />
                            <TextBlock Text="Reset Decoder" TextAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <!-- Row 3: Frame Pacing (closest to Other button, animates first) -->
                    <Button x:Name="FramePacingMenuButton" Grid.Row="3" Grid.Column="4"
                            Style="{StaticResource StreamActionButtonStyle}" Click="toggleFramePacing_Click" Opacity="0"
                            GotFocus="SubMenuButton_GotFocus" LostFocus="SubMenuButton_LostFocus">
                        <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                        <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B9;" FontSize="24" HorizontalAlignment="Center" />
                            <TextBlock Text="Switch frame pacing mode" TextAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Main menu row -->
                <Button x:Name="FirstMenuButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource StreamActionButtonStyle}" Click="toggleMouseButton_Click" Opacity="0">
                    <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE962;" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock x:Name="MouseModeText" Text="{x:Bind MouseMode, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Mouse On|Mouse Off'}" TextAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button x:Name="KeyboardMenuButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource StreamActionButtonStyle}" Click="showKeyboardButton_Click" Opacity="0">
                    <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE92E;" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="Keyboard" TextAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button x:Name="StatsMenuButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource StreamActionButtonStyle}" Click="toggleStatsButton_Click" Opacity="0">
                    <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEC48;" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ShowStatsText" Text="{x:Bind ShowStats, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Stats On|Stats Off'}" TextAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button x:Name="LogsMenuButton" Grid.Row="1" Grid.Column="3" Style="{StaticResource StreamActionButtonStyle}" Click="toggleLogsButton_Click" Opacity="0">
                    <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xF0B5;" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ShowLogsText" Text="{x:Bind ShowLogs, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Logs On|Logs Off'}" TextAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <!-- Other button: focuses reveal sub-menu above; no flyout -->
                <Button Grid.Row="1" Grid.Column="4" x:Name="otherActionsButton" Style="{StaticResource StreamActionButtonStyle}" Opacity="0"
                        GotFocus="OtherButton_GotFocus" LostFocus="OtherButton_LostFocus">
                    <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE712;" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="Other" TextAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button x:Name="DisconnectMenuButton" Grid.Row="1" Grid.Column="6" Style="{StaticResource StreamActionButtonStyle}" Click="disonnectButton_Click" Opacity="0">
                    <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72D;" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="Disconnect" TextAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button x:Name="CloseAppMenuButton" Grid.Row="1" Grid.Column="7" Style="{StaticResource StreamActionButtonStyle}" Click="disconnectAndCloseButton_Click" Opacity="0">
                    <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71A;" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="Close App" TextAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </SwapChainPanel>
        <Grid x:Name="ProgressView" Background="{ThemeResource ThemeBackgroundColor}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border x:Name="PageBackgroundImage"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Margin="-150"
                    IsHitTestVisible="False" Opacity="0">
                <Border.Background>
                    <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
                        <ImageBrush.RelativeTransform>
                            <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.5" ScaleY="1.5" />
                        </ImageBrush.RelativeTransform>
                    </ImageBrush>
                </Border.Background>
            </Border>
            <StackPanel x:Name="ProgressStack" HorizontalAlignment="Center" VerticalAlignment="Center"  Orientation="Vertical">
                <Image x:Name="MainProgressRing" Source="ms-appx:///Assets/logo2.gif" Margin="0,0,0,24" Width="48" Height="48"></Image>
                <TextBlock x:Name="StatusText" TextAlignment="Center" Text="Initializing Moonlight..."/>
                <TextBlock x:Name="StepText" FontSize="8px" TextAlignment="Center" Text="" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
        <Grid x:Name="ClosingOverlay" Visibility="Collapsed"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.Background>
                <SolidColorBrush Color="#000000" Opacity="0.65"/>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Image Source="ms-appx:///Assets/loading2.gif" Width="48" Height="48" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ClosingOverlayText" Text="Closing..." HorizontalAlignment="Center" FontSize="14" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>

</Page>
