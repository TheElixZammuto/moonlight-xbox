<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///UI/Pages/AppPage/AppPage.Resources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="AppGridViewItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource BaseListViewItem}">
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          DataContext="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" >
                        <Grid x:Name="AppVisualRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="{StaticResource GridScale}" ScaleY="{StaticResource GridScale}"/>
                            </Grid.RenderTransform>

                            <Rectangle x:Name="AppImageBlurRect" Opacity="0" IsHitTestVisible="False"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Visibility="Collapsed"
                                       RadiusX="12" RadiusY="12">
                                <Rectangle.Fill>
                                    <ImageBrush Stretch="UniformToFill" ImageSource="{Binding GlowImage}" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid x:Name="AppAspectRatioBox" Width="165" Height="250"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle x:Name="AppImageRect" RadiusX="12" RadiusY="12" Opacity="1" IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Image}" />
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Rectangle x:Name="Desaturator" Fill="#FF000000" Opacity="{StaticResource UnselectedDesaturatorOpacity}"
                                           RadiusX="12" RadiusY="12" IsHitTestVisible="False"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />


                                <Rectangle x:Name="Play" RadiusX="12" RadiusY="12" IsHitTestVisible="False" Margin="60"
                                           Visibility="{Binding CurrentlyRunning, Converter={StaticResource BoolToVis}}">
                                    <Rectangle.Fill>
                                        <ImageBrush Stretch="Uniform" ImageSource="ms-appx:///Assets/Play1.png" />
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Border x:Name="FavoriteBadge" Background="#AA000000" CornerRadius="12" Width="28" Height="28"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsHitTestVisible="False"
                                        Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE735;" FontSize="14" Foreground="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="{StaticResource UnselectedBlurGlowOpacity}" Duration="{StaticResource SharedAnimationDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Desaturator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="{StaticResource UnselectedDesaturatorOpacity}" Duration="{StaticResource SharedAnimationDuration}"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="{StaticResource SharedAnimationDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Desaturator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="{StaticResource SharedAnimationDuration}"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="AppImageBlurRect"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="{StaticResource SharedAnimationDuration}"/>
                                        <DoubleAnimation Storyboard.TargetName="Desaturator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="{StaticResource SharedAnimationDuration}"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
